# Copy to ~/.tool-storage.env (not Git), then fill in the local SSD binding.
# TOOL_STORAGE_ROOT is a directory inside TOOL_STORAGE_VOLUME.
export TOOL_STORAGE_VOLUME='/path/to/mounted/ssd'
export TOOL_STORAGE_ROOT="$TOOL_STORAGE_VOLUME/ToolCache"
# Match this ID to ToolCache/.storage-id on the selected SSD.
export TOOL_STORAGE_ID='replace-with-a-unique-id'
export TOOL_COLIMA_BIN='/path/to/internal/colima'
export TOOL_DOCKER_BIN='/path/to/internal/docker'
export TOOL_TIUP_BIN="$HOME/.local/libexec/tiup"
